{
  "name": "@identisure/client",
  "version": "0.1.0",
  "description": "API client for the Identisure REST API",
  "type": "module",
  "main": "./dist/identisure-client.cjs",
  "module": "./dist/identisure-client.js",
  "types": "./dist/identisure-client.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/identisure-client.d.ts",
        "default": "./dist/identisure-client.js"
      },
      "require": {
        "types": "./dist/identisure-client.d.cts",
        "default": "./dist/identisure-client.cjs"
      }
    }
  },
  "license": "MIT",
  "homepage": "https://developers.identisure.com",
  "bugs": {
    "url": "https://github.com/identisure/idk-clients/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/identisure/idk-clients.git"
  },
  "keywords": [
    "bankid",
    "eid",
    "identity",
    "authentication"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "gen:doc": "typedoc src/index.ts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.8.3",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "unplugin-dts-bundle-generator": "3.4.1",
    "vite": "8.0.16",
    "vitest": "5.0.5"
  }
}
